[Unit]
Description=XianYuPlus online update agent
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
EnvironmentFile=/etc/xianyu-plus/update-agent.env
ExecStart=/usr/local/lib/xianyu-plus/xianyu-plus-update-agent.sh
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
